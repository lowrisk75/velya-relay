# Velya Cloud Relay - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=8080

# PostgreSQL
PG_PASSWORD=change-this-secure-password-123

# Redis
REDIS_PASSWORD=change-this-secure-password-456

# APNs Configuration
# You need an Apple Developer account ($99/year) to generate these keys
# Get your Team Scoped Key at: https://developer.apple.com/account/resources/authkeys/list
APNS_KEY_ID=YOUR_KEY_ID_HERE
APNS_TEAM_ID=YOUR_TEAM_ID_HERE
APNS_BUNDLE_ID=com.lorislab.velya
APNS_PRODUCTION=false

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=change-this-to-a-random-64-char-string

# IMPORTANT: Place your APNs key file in ./keys/AuthKey.p8
# Download it from Apple Developer Portal and rename it to AuthKey.p8
