# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    Velya Cloud Relay - Configuration                      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# SETUP STEPS:
#   1. Copy this file:           cp .env.example .env
#   2. Generate secrets:         openssl rand -base64 64
#   3. Download APNs key:        https://developer.apple.com/account/resources/authkeys/list
#   4. Place in ./keys/:         mv ~/Downloads/AuthKey_*.p8 ./keys/AuthKey.p8
#   5. Set permissions:          chmod 600 ./keys/AuthKey.p8
#   6. Fill in values below
#   7. Start stack:              docker-compose up -d

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Port for HTTP/WebSocket server
PORT=8080

# Node environment (development | production)
NODE_ENV=production

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Database - PostgreSQL 16
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (used by docker-compose and application)
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=velya_relay
PG_USER=velya_user
PG_PASSWORD=change-this-secure-password-123

# SECURITY: Use a strong password (32+ chars, mix of alphanumeric + symbols)
# Generate with: openssl rand -base64 32

# Connection pool settings (optional, defaults shown)
# PG_POOL_MIN=2
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT=30000

# ─────────────────────────────────────────────────────────────────────────────
# Cache - Redis 7
# ─────────────────────────────────────────────────────────────────────────────

# Redis connection (used for WebSocket presence and command queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-secure-password-456

# SECURITY: Use a strong password (32+ chars)
# Generate with: openssl rand -base64 32

# Redis database number (0-15, default: 0)
# REDIS_DB=0

# ─────────────────────────────────────────────────────────────────────────────
# Apple Push Notification Service (APNs)
# ─────────────────────────────────────────────────────────────────────────────

# APNs Key ID (10 characters, e.g., "ANAK3AMTW4")
# Find at: https://developer.apple.com/account/resources/authkeys/list
APNS_KEY_ID=YOUR_KEY_ID_HERE

# Apple Developer Team ID (10 characters, e.g., "TDV6D5L785")
# Find at: https://developer.apple.com/account (top-right corner)
APNS_TEAM_ID=YOUR_TEAM_ID_HERE

# iOS App Bundle Identifier
# Must match your iOS app's bundle ID exactly
APNS_BUNDLE_ID=com.lorislab.velya

# APNs Environment
#   false = Sandbox (development builds, TestFlight)
#   true  = Production (App Store builds)
APNS_PRODUCTION=false

# APNs Key File Path (relative to project root)
# Default: ./keys/AuthKey.p8
# APNS_KEY_PATH=./keys/AuthKey.p8

# IMPORTANT:
#   1. Download your APNs key from Apple Developer Portal (one-time download!)
#   2. Rename it to "AuthKey.p8" and place in ./keys/ directory
#   3. Set restrictive permissions: chmod 600 ./keys/AuthKey.p8
#   4. NEVER commit this file to Git (already in .gitignore)
#
# Team-scoped APNs keys work for ALL apps under your Team ID, so one key can
# serve multiple bundle IDs (velya, velya-dev, velya-staging, etc.)

# ─────────────────────────────────────────────────────────────────────────────
# Authentication - JWT Tokens
# ─────────────────────────────────────────────────────────────────────────────

# JWT Secret for signing device authentication tokens
# CRITICAL: Keep this secret! If leaked, regenerate immediately.
JWT_SECRET=change-this-to-a-random-64-char-string

# Generate a secure secret:
#   openssl rand -base64 64
#
# Token expiration: 7 days (hardcoded in src/auth/jwt.ts)
# Devices must re-authenticate weekly by calling POST /v1/auth/login

# ─────────────────────────────────────────────────────────────────────────────
# API Keys - Node-RED / External Services
# ─────────────────────────────────────────────────────────────────────────────

# API keys for external services are stored in PostgreSQL (node_red_keys table)
# Create them via SQL after first startup:
#
#   INSERT INTO node_red_keys (api_key, description, api_key_hash)
#   VALUES (
#     'velya-nodered-prod-2024',
#     'Node-RED Production Instance',
#     crypt('velya-nodered-prod-2024', gen_salt('bf', 12))
#   );
#
# Then use in HTTP requests:
#   Authorization: Bearer velya-nodered-prod-2024
#
# API keys never expire but can be revoked by deleting the row.

# ─────────────────────────────────────────────────────────────────────────────
# Webhooks (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# Webhook retry configuration (optional, defaults shown)
# WEBHOOK_MAX_RETRIES=3
# WEBHOOK_RETRY_DELAY_MS=5000
# WEBHOOK_TIMEOUT_MS=10000

# Webhook URLs are configured per-alarm via API:
#   POST /v1/alarms
#   {
#     "webhook_url": "https://your-automation.com/hooks/alarm-delivered",
#     ...
#   }

# ─────────────────────────────────────────────────────────────────────────────
# CORS (Cross-Origin Resource Sharing)
# ─────────────────────────────────────────────────────────────────────────────

# Allowed origins for CORS (comma-separated, or "*" for all)
# CORS_ORIGIN=https://dashboard.yourdomain.com,https://admin.yourdomain.com

# If not set, defaults to "*" (allow all origins)
# For production, restrict to your frontend domains only

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# API rate limits (requests per window)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# WebSocket connection limits per device
# WS_MAX_CONNECTIONS_PER_DEVICE=3

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring & Observability (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# Prometheus metrics endpoint (enabled by default at /metrics)
# METRICS_ENABLED=true

# Sentry error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─────────────────────────────────────────────────────────────────────────────
# Docker-Compose Overrides (only used by docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# These variables are used to configure the docker-compose services themselves,
# not the application. They're referenced in docker-compose.yml.

# PostgreSQL Docker image tag
# POSTGRES_VERSION=16-alpine

# Redis Docker image tag
# REDIS_VERSION=7-alpine

# ═════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT CHECKLIST (before going to production):
# ═════════════════════════════════════════════════════════════════════════════
#
#  [ ] Changed all default passwords (PG_PASSWORD, REDIS_PASSWORD, JWT_SECRET)
#  [ ] Downloaded and placed APNs key in ./keys/AuthKey.p8 with chmod 600
#  [ ] Set APNS_PRODUCTION=true for App Store builds
#  [ ] Restricted CORS_ORIGIN to your actual frontend domains
#  [ ] Created at least one API key in node_red_keys table
#  [ ] Configured SSL/TLS termination (Nginx, Caddy, or Railway auto-SSL)
#  [ ] Set up daily database backups (see DEPLOYMENT.md)
#  [ ] Configured log aggregation (optional: Grafana Loki, Datadog, etc.)
#  [ ] Tested alarm delivery end-to-end (device locked + app killed)
#  [ ] Verified webhook delivery to your automation platform
#  [ ] Set up uptime monitoring (UptimeRobot, Pingdom, etc.)
#
# ═════════════════════════════════════════════════════════════════════════════
