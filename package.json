{
  "name": "velya-relay",
  "version": "1.0.0",
  "description": "Cloud relay server for Velya iOS app - WebSocket + REST API for Node-RED/Home Assistant integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "generate-api-key": "tsx scripts/generate-api-key.ts"
  },
  "keywords": [
    "velya",
    "websocket",
    "relay",
    "node-red",
    "home-assistant",
    "iot"
  ],
  "author": "Kevin Nadjarian <mail@kevinn.ie>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@parse/node-apn": "^8.1.0",
    "@types/bcryptjs": "^2.4.6",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "uwebsockets.js": "github:uNetworking/uWebSockets.js#v20.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
